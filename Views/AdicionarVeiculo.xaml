<Window x:Class="AppPortariaControle.Views.AdicionarVeiculo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppPortariaControle.Views"
        mc:Ignorable="d"
        Title="Adicionar Veiculo" MaxHeight="280" MaxWidth="560" MinHeight="280" MinWidth="560" 
        
        WindowStartupLocation="CenterScreen"
         Icon="/Imagens/icon-default.png">
    <Grid>
       
        <Label Content="Condutor" FontSize="15" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10,8,0,0" ></Label>
        <TextBox x:Name="txtNomeFunc" FontSize="16"  Height="23" VerticalAlignment="Top"  Margin="84,10,10,0" ></TextBox>
        <DataGrid x:Name="dataGridFuncionários" AutoGenerateColumns="False" Height="120" VerticalAlignment="Top" Margin="84,35,10,0"
        IsReadOnly="True" HeadersVisibility="None" SelectionChanged="dataGridFuncionários_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Motorista}" IsReadOnly="True" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Label Content="Tipo" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,156,60,0" FontSize="16" RenderTransformOrigin="0.403,0.67" ></Label>


        <Label Content="Placa" VerticalAlignment="Top" HorizontalAlignment="Left" FontSize="16" Margin="32,156,0,0"/>
        <TextBox x:Name="txtPlaca" Width="100" Height="23" HorizontalAlignment="Left"  MaxLength="7" FontSize="16" TextWrapping="Wrap"
                 VerticalAlignment="Top" Margin="84,159,0,0" />


        <ComboBox Name="comboBoxVeiculo" Background="White" Width="74" Height="23"
                  VerticalAlignment="Top" HorizontalAlignment="Center" Margin="60,160,0,0" SelectedItem="comboBoxVeiculo_selectedItem" BorderBrush="White">

            <ComboBoxItem Content="Carro"></ComboBoxItem>
            <ComboBoxItem Content="Moto"></ComboBoxItem>
        </ComboBox>

        <Label Content="Modelo" VerticalAlignment="Top" HorizontalAlignment="Right" FontSize="16" Margin="0,155,110,0" RenderTransformOrigin="0.926,0.541"></Label>
        <TextBox x:Name="txtModelo" Width="100" FontSize="16" Height="23"
                 VerticalAlignment="Top" HorizontalAlignment="Right" Margin="0,159,10,0"></TextBox>


        <Button Width="20" Height="20" Content="" VerticalAlignment="Top" HorizontalAlignment="Right" Click="btnBuscar_click" Margin="0,10,10,0" FontSize="8" Cursor="Hand">
            <Button.Background>
                <ImageBrush ImageSource="/Imagens/icon-pesquisa.png" Stretch="Uniform"/>
            </Button.Background>
        </Button>


        <Button Content="Confirmar" Width="60" Height="20" VerticalAlignment="Bottom"
                HorizontalAlignment="Right" Margin="0,0,10,7" Cursor="Hand" Click="Button_Click">

        </Button>
    </Grid>
</Window>
