<Window x:Class="AppPortariaControle.ViewsUI.DadosEmpresa"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppPortariaControle.ViewsUI"
        mc:Ignorable="d"
                WindowStartupLocation="CenterScreen"
       xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      
       Title="Dados Empresa" MaxHeight="470" MaxWidth="700" MinHeight="470" MinWidth="700">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <Grid>
        <TextBlock x:Name="txtEmp" HorizontalAlignment="Center" FontSize="16" Margin="10"></TextBlock>
            <Button VerticalAlignment="Top" HorizontalAlignment="Right" BorderBrush="{x:Null}"
Width="45"  ToolTip="Adicionar prestador de serviço"
 ToolTipService.InitialShowDelay="0"     
 ToolTipService.ShowDuration="5000"
 FontFamily="Arial"
Height="40" Click="AdicionarPrestador_Click" Margin="0 0 10 0" Cursor="Hand" Background="Transparent" Foreground="Black">
                <Icon:PackIconMaterial Kind="Account" Width="30" Height="30" />
            </Button>
            <Button VerticalAlignment="Top" HorizontalAlignment="Right" BorderBrush="{x:Null}"
Width="45"  ToolTip="Adicionar prestador de serviço"
 ToolTipService.InitialShowDelay="0"     
 ToolTipService.ShowDuration="5000"
 FontFamily="Arial"
Height="40" Click="ExcluirEmpresa_Click" Margin="0 0 60 0" Cursor="Hand" Background="Transparent" Foreground="Black">
                <Icon:PackIconMaterial Kind="Delete" Width="30" Height="30" Foreground="Red"/>
            </Button>
        </Grid>
      
        <Grid Grid.Row="1">
            <DataGrid x:Name="dataGridVisitantes"  AutoGenerateColumns="False" VerticalAlignment="Bottom" Margin="12,0,12,12"
        IsReadOnly="True" HeadersVisibility="Column" HorizontalScrollBarVisibility="Auto"
VerticalScrollBarVisibility="Auto" Grid.RowSpan="4" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nome" Binding="{Binding NomeFunc}" IsReadOnly="True" Width="250"/>
                    <DataGridTextColumn Header="Doc" FontFamily="Arial" FontSize="18" Binding="{Binding TipoDocumento}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Documento" FontFamily="Arial" FontSize="18" Width="250">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource DocumentFormatterMultiConverter}">
                                <Binding Path="Documento"/>
                                <Binding Path="TipoDocumento"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>
                    <DataGridTemplateColumn Header="Ações">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button  
                                      Click="Excluir_Click" 
                                      Width="30" 
                                      Height="25"
                                      Tag="{Binding}"
                                      Background="Transparent" Cursor="Hand">
                                        <Image Source="/Imagens/lixeira.png" Stretch="Fill"></Image>
                                    </Button>

                                    <Button  
                                      Click="Update_Click" 
                                      Width="30" 
                                      Height="25"
                                      Tag="{Binding}"
                                      Background="Transparent" Cursor="Hand">
                                        <Image Source="/Imagens/edicao.png" Stretch="Fill"></Image>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>

                        </DataGridTemplateColumn.CellTemplate>

                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</Window>
