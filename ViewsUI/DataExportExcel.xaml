<Window x:Class="AppPortariaControle.ViewsUI.DataExportExcel"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppPortariaControle.ViewsUI"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Title="DataExportExcel" Height="180" Width="300">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Label and DatePicker for Start Date -->
        <Label Content="Data de Início:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="5" />
        <DatePicker Name="StartDatePicker" Grid.Row="0" Grid.Column="1" Margin="5" />

        <!-- Label and DatePicker for End Date -->
        <Label Content="Data de Fim:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="5" />
        <DatePicker Name="EndDatePicker" Grid.Row="1" Grid.Column="1" Margin="5" />

        <!-- Confirm Button -->
        <Button Content="Confirmar" Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="5" Width="100" Height="30"
                Click="ConfirmButton_Click" />
    </Grid>
    
</Window>
