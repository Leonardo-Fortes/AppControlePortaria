<Page x:Class="AppPortariaControle.ViewsUI.Page1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AppPortariaControle.ViewsUI"
      xmlns:outro="clr-namespace:AppPortariaControle.Services" xmlns:Icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
      mc:Ignorable="d" 
      d:DesignHeight="610" d:DesignWidth="800"
      Title="Page1"
      >
    <Border Background="#000171" CornerRadius="0 20 20 0" Padding="0">
        <Grid>
            <Button x:Name="BtnEntradaVisitantes" Content="Entrada" Width="130" Height="35" HorizontalAlignment="Right" VerticalAlignment="Center"
            FontWeight="Bold" FontSize="12" Foreground="Black" Cursor="Hand"
            Background="#91f534" BorderBrush="#91f534" BorderThickness="2"
            Padding="0" Margin="0,0,150,245" RenderTransformOrigin="0.5,0.5" Click="BtnEntradaVisitantes_Click">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15"
                                    Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FF66BB6A"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FF4CAF50"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
                <Button.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform/>
                        <SkewTransform AngleX="-1.373"/>
                        <RotateTransform/>
                        <TranslateTransform X="-0.599"/>
                    </TransformGroup>
                </Button.RenderTransform>
            </Button>

            <!-- Botão Saída -->
            <Button x:Name="BtnSaidaVisitantes" Content="Saída" Width="130" Height="35" VerticalAlignment="Center" HorizontalAlignment="Right"
            FontWeight="Bold" FontSize="12" Foreground="Black" Cursor="Hand"
            Background="#FFF44336" BorderBrush="#FFD32F2F" BorderThickness="2"
            Padding="5" Margin="0,0,10,245" Click="BtnSaidaVisitantes_Click">
                <Button.Resources>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="border" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="15"
                                    Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="border" Property="Background" Value="#FFE57373"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="#FFF44336"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="3" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>

            <Button  Background="Transparent"
             HorizontalAlignment="Right" 
             BorderBrush="Transparent"
             VerticalAlignment="Top" 
             Width="40" Margin="5" 
             Height="25" 
             Click="Minimizar_Click" Cursor="Hand"
>
             <Icon:PackIconMaterial Kind="WindowMinimize" Foreground="White" Width="30" Height="15" Margin="0,0,0,0" Cursor="" />
            </Button>

            

            <!-- Botão Adicionar -->
            <Button  VerticalAlignment="Center" HorizontalAlignment="Right" FontFamily="Arial"
         ToolTip="Adicionar Empresa"
         ToolTipService.InitialShowDelay="0"     
         ToolTipService.ShowDuration="5000"
        Margin="0,0,60,330" FontSize="16" FontWeight="Bold" BorderBrush="{x:Null}" Width="40" Height="40" Click="AdicionarPrestadorEmp_Click" Cursor="Hand">
                <Button.Background>
                    <ImageBrush ImageSource="/Imagens/cadastro-1.png" Stretch="Uniform"/>
                </Button.Background>
            </Button>
           

            <!-- FIM Botão Adicionar -->
            <!-- Inicio Botão Listar -->
            <Button   VerticalAlignment="Center" 
         ToolTip="Listar visitantes dentro da empresa"
         ToolTipService.InitialShowDelay="0"     
         ToolTipService.ShowDuration="5000"
         HorizontalAlignment="Right" FontFamily="Arial"
    Margin="0,0,10,330" FontSize="16" FontWeight="Bold" BorderBrush="{x:Null}" Width="40" Height="40" Click="ListarPrestadorEmp_Click" Cursor="Hand">
                <Button.Background>
                    <ImageBrush ImageSource="/Imagens/menu-aberto.png" Stretch="Uniform">

                    </ImageBrush>

                </Button.Background>
            </Button>
            <Grid Cursor="">
                <Label Width="214" Height="30" VerticalAlignment="Center" HorizontalAlignment="Left" Content="Digite o nome da empresa"
              FontWeight="Bold" FontSize="16" FontFamily="Arial"  Foreground="White" Margin="7,0,0,300" />
                <TextBox Width="205" Height="25" VerticalAlignment="Center" HorizontalAlignment="Left" x:Name="TxbEmp" Margin="12,0,0,240" FontSize="16" />


                <!--Inicio Button buscar Empresa-->
                <Button x:Name="BtnBuscarEmp" Click="BtnBuscarEmp_Click" Width="70" Height="25" Cursor="Hand" VerticalAlignment="top" HorizontalAlignment="left"
               Margin="220,173,0,0" Padding="0" Content="Buscar" FontFamily="Arial" Foreground="White">
                    <Button.Background>
                        <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                            <GradientStop Color="Black"/>
                            <GradientStop Color="#FF518CFF" Offset="1"/>
                        </LinearGradientBrush>
                    </Button.Background>
                </Button>
                <Button Style="{StaticResource NoHoverButtonStyle}" VerticalAlignment="Top"
                    ToolTip="Exportar Excel" HorizontalAlignment="Right" FontFamily="Arial"
                    ToolTipService.InitialShowDelay="0"     
                    ToolTipService.ShowDuration="5000"
                    Margin="0,120,140,0" FontSize="16" FontWeight="Bold" BorderBrush="{x:Null}" Width="40" Height="40" Click="ExportExcel_Click" Cursor="Hand">
                    <Icon:PackIconMaterial Kind="FileDocument" Width="30" Height="30" Margin="0,0,0,0" />

                </Button>
                
                <Button Style="{StaticResource NoHoverButtonStyle}" VerticalAlignment="Top"
      ToolTip="Visitantes dentro da empresa" HorizontalAlignment="Right" FontFamily="Arial"
      ToolTipService.InitialShowDelay="0"     
      ToolTipService.ShowDuration="5000"
      Margin="0,120,100,0" FontSize="16" FontWeight="Bold" BorderBrush="{x:Null}" Width="40" Height="40" Click="VisitantesDentro_Click" Cursor="Hand">
                    <Icon:PackIconMaterial Foreground="Yellow" Kind="Alert" Width="35" Height="40" Margin="0,0,0,0" />

                </Button>


                <!--FIM Button buscar Empresa-->

                <Label Content="Portal de Acesso de Visitantes/Terceiros" HorizontalAlignment="Center" Margin="0,27,0,0" VerticalAlignment="Top" FontSize="30"  Foreground="White" FontFamily="Arial" FontWeight="Bold" />
            </Grid>

            <DataGrid x:Name="dataGridVisitantes"  AutoGenerateColumns="False" VerticalAlignment="Bottom" Height="390" Margin="12,0,12,12"
                          IsReadOnly="True" CanUserAddRows="False" MouseDoubleClick="DoubleClick_Empresa" >
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Empresa" FontFamily="Arial" FontSize="18" Binding="{Binding NomeEmp}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Nome Prestador de Serviço" FontSize="18" FontFamily="Arial"  Binding="{Binding NomeFunc}" IsReadOnly="True" Width="*"/>
                    <DataGridTextColumn Header="Entrada" FontFamily="Arial" FontSize="18"  Binding="{Binding Entrada}" IsReadOnly="True" Width="130"/>
                    <DataGridTextColumn Header="Doc" FontFamily="Arial" FontSize="18" Binding="{Binding TipoDocumento}" IsReadOnly="True" Width="80"/>
                    <DataGridTextColumn Header="Documento" FontFamily="Arial" FontSize="18" Width="150">
                        <DataGridTextColumn.Binding>
                            <MultiBinding Converter="{StaticResource DocumentFormatterMultiConverter}">
                                <Binding Path="Documento"/>
                                <Binding Path="TipoDocumento"/>
                            </MultiBinding>
                        </DataGridTextColumn.Binding>
                    </DataGridTextColumn>

                </DataGrid.Columns>
            </DataGrid>
            </Grid>
        
    </Border>
</Page>
